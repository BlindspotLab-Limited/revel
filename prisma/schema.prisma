generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

/// Same client for the Cloudflare Workers runtime: loads the query compiler
/// as a pre-compiled WASM module (Workers forbid compiling WASM at runtime).
/// Only the Cloudflare build uses it — next.config.ts aliases
/// `@/lib/generated/prisma/client` to this output when
/// REVEL_BUILD_TARGET=cloudflare. Schema, models and migrations are shared.
generator workerd {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma-workerd"
  runtime             = "workerd"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id
  email                  String?           @unique
  name                   String?
  username               String?           @unique
  image                  String?
  passwordHash           String?           @map("password_hash")
  passwordResetTokenHash String?           @map("password_reset_token_hash")
  passwordResetExpires   DateTime?         @map("password_reset_expires") @db.Timestamptz(6)
  isAdmin                Boolean           @default(false) @map("is_admin")
  createdAt              DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  analyses               Analysis[]
  activityEvents         ActivityEvent[]
  integrations           UserIntegration[]

  @@map("users")
}

/** Per-user OAuth tokens for private exports (Linear, Notion, GitHub Gist). */
model UserIntegration {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id")
  provider             String
  accessTokenEncrypted String    @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  tokenExpiresAt       DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scopes               String?
  /** Non-secret display + routing data (teamId, databaseId, login, workspace name). */
  metadata             Json?     @db.JsonB
  connectedAt          DateTime? @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "user_integrations_user_provider_key")
  @@index([userId], map: "idx_user_integrations_user_id")
  @@map("user_integrations")
}

model Analysis {
  id              String           @id @db.Uuid
  userId          String?          @map("user_id")
  website         String
  /** processing | completed | partial | failed */
  status          String           @default("processing")
  score           Int?
  error           String?
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  /** Set when the run reaches a terminal state (completed, partial or failed). */
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  /** Wall-clock run duration, for median/p95 reporting. */
  durationMs      Int?             @map("duration_ms")
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  report          Report?
  partnerAnalysis PartnerAnalysis?

  @@index([userId], map: "idx_analyses_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_analyses_created_at")
  @@map("analyses")
}

model Report {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId String    @unique @map("analysis_id") @db.Uuid
  jsonResult Json      @map("json_result") @db.JsonB
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  analysis   Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId], map: "idx_reports_analysis_id")
  @@map("reports")
}

model ActivityEvent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType  String    @map("event_type")
  source     String
  userId     String?   @map("user_id")
  toolName   String?   @map("tool_name")
  analysisId String?   @map("analysis_id") @db.Uuid
  website    String?
  status     String?
  metadata   Json?     @db.JsonB
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)], map: "idx_activity_events_created_at")
  @@index([eventType], map: "idx_activity_events_event_type")
  @@index([source], map: "idx_activity_events_source")
  @@index([userId], map: "idx_activity_events_user_id")
  @@map("activity_events")
}

/**
 * One row per AI provider attempt — including attempts that failed, so cost
 * per completed audit includes the retries and fallbacks it really consumed.
 *
 * NULL token/cost columns mean "unknown", never zero. `costSource`
 * distinguishes a genuinely free call from a missing price.
 * Holds no prompts, page bodies, credentials or user content.
 */
model AiUsageEvent {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** Unique per attempt — the idempotency key that prevents double accounting. */
  attemptId                 String    @unique @map("attempt_id") @db.Uuid
  analysisId                String?   @map("analysis_id") @db.Uuid
  source                    String?
  provider                  String
  /** Exact model identifier as sent to the provider. */
  model                     String
  status                    String
  /** 0-based attempt counter within one audit. */
  attemptIndex              Int       @default(0) @map("attempt_index")
  latencyMs                 Int       @map("latency_ms")
  providerRequestId         String?   @map("provider_request_id")
  httpStatus                Int?      @map("http_status")
  inputTokens               Int?      @map("input_tokens")
  outputTokens              Int?      @map("output_tokens")
  totalTokens               Int?      @map("total_tokens")
  reasoningTokens           Int?      @map("reasoning_tokens")
  cachedInputTokens         Int?      @map("cached_input_tokens")
  /** True when reasoningTokens are already inside outputTokens. */
  reasoningIncludedInOutput Boolean?  @map("reasoning_included_in_output")
  /** provider_reported | estimated | unavailable */
  usageSource               String    @map("usage_source")
  reportedCostUsd           Decimal?  @map("reported_cost_usd") @db.Decimal(14, 8)
  estimatedCostUsd          Decimal?  @map("estimated_cost_usd") @db.Decimal(14, 8)
  /** provider_reported | estimated | free_tier | unknown */
  costSource                String    @map("cost_source")
  pricingVersion            String?   @map("pricing_version")
  errorKind                 String?   @map("error_kind")
  errorDetail               String?   @map("error_detail")
  createdAt                 DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_ai_usage_events_created_at")
  @@index([analysisId], map: "idx_ai_usage_events_analysis_id")
  @@index([provider, model], map: "idx_ai_usage_events_provider_model")
  @@index([status], map: "idx_ai_usage_events_status")
  @@index([source], map: "idx_ai_usage_events_source")
  @@map("ai_usage_events")
}

model Partner {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  domain        String?          @unique
  contactEmail  String?          @map("contact_email")
  status        String           @default("pending")
  accessType    String           @default("paid") @map("access_type")
  creditsBalance Int             @default(0) @map("credits_balance")
  monthlyQuota  Int?             @map("monthly_quota")
  notes         String?
  createdAt     DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?        @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiKeys       PartnerApiKey[]
  analyses      PartnerAnalysis[]

  @@index([status], map: "idx_partners_status")
  @@index([accessType], map: "idx_partners_access_type")
  @@map("partners")
}

model PartnerApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId  String    @map("partner_id") @db.Uuid
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @map("key_hash")
  label      String?
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([keyPrefix], map: "idx_partner_api_keys_prefix")
  @@index([partnerId], map: "idx_partner_api_keys_partner_id")
  @@map("partner_api_keys")
}

model PartnerAnalysis {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId  String    @map("partner_id") @db.Uuid
  analysisId String    @unique @map("analysis_id") @db.Uuid
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  analysis   Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([partnerId], map: "idx_partner_analyses_partner_id")
  @@map("partner_analyses")
}
